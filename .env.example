# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# Note: Multiple fallback keys can be passed as a comma-separated list.
GEMINI_API_KEY = 

OPENWEATHER_API_KEY=ADD_YOUR_KEY
# Note: Real-time weather works out-of-the-box via Open-Meteo without needing any API key!
# If you provide an OpenWeatherMap API key in the Secrets panel, it will be used as a primary source.

SUPABASE_URL=SUPABASE_URL
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

